# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your actual values.
# NEVER commit your real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini AI ────────────────────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Sarvam AI ────────────────────────────────────────────────────────────────
# Get your API key from: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Resume Structurer ────────────────────────────────────────────────────────
RESUME_STRUCTURER_KEY=your_resume_structurer_key_here

# ── GitHub OAuth (optional — for Resume Forge GitHub integration) ────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ── LinkedIn OAuth (for Trainee LinkedIn Integration) ────────────
# Provision a free LinkedIn developer app (OpenID Connect)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# ── Serper (optional — for Nexus-Hunter job discovery) ───────────────────────
# Get your API key from: https://serper.dev/
SERPER_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
APP_RETURN_URL=http://localhost:3000/

# ── Admin Bootstrap (bootstrap only — see server/lib/seedAdminUser.js) ──────────
# Set this on first launch to seed the first SUPER_ADMIN from the AdminUser table.
# After the first admin exists, manage admins via the DB directly — this var is ignored.
ADMIN_GITHUB_USERNAME=

# ── Database (Prisma) ─────────────────────────────────────────────────────────
# Default local development uses SQLite (matching prisma/schema.prisma provider = "sqlite"):
DATABASE_URL="file:./dev.db"

# For production deployment with PostgreSQL (requires setting provider = "postgresql" in prisma/schema.prisma):
# DATABASE_URL="postgresql://user:password@localhost:5432/forgev3"
# DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Legacy Python Backend (optional — only needed if running legacy/) ────────
CEREBRAS_API_KEY=
PDFMONKEY_API_KEY=
PDFMONKEY_TEMPLATE_ID=

